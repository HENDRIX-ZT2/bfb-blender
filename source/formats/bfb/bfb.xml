<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE niftoolsxml>
<niftoolsxml version="0.7.1.0">

	<xi:include href="../base/base.xml" xmlns:xi="http://www.w3.org/2001/XInclude" xpointer="xpointer(*/*)" />

    <basic name="ubyte50" integral="true" countable="true">
        An unsigned 16-bit integer.
    </basic>

	<enum name="BlockType" storage="ushort">
		<option value="1" name="Sphere" />
		<option value="3" name="BoundingBox" />
		<option value="4" name="Capsule" />
		<option value="5" name="Mesh" />
		<option value="6" name="MeshData" />
		<option value="8" name="MeshSkinned" />
	</enum>

	<enum name="NodeType" storage="uint">
		<option value="1" name="Node" />
		<option value="2" name="LodGroup" />
		<option value="3" name="MeshLink" />
		<option value="4" name="BillboardLink" />
		<option value="5" name="CapsuleLink" />
		<option value="6" name="ParticleLink" />
	</enum>

    <compound name="Sphere">
        <add name="flag" type="ushort" default="1"/>
        <add name="pos" type="Vector3" />
        <add name="radius" type="float" />
    </compound>

    <compound name="BoundingBox">
        <add name="flag" type="ushort" default="1"/>
        <add name="matrix" type="Matrix44" />
        <add name="extent" type="Vector3" />
    </compound>

    <compound name="Capsule">
        <add name="flag" type="ushort" default="1"/>
        <add name="start" type="Vector3" />
        <add name="end" type="Vector3" />
        <add name="radius" type="float" />
    </compound>

    <compound name="MeshReader">
    </compound>

    <compound name="MeshData">
        <add name="flag" type="ubyte" default="8"/>
        <add name="BFRVertex" type="FixedString" arg="64"/>
        <add name="size_of_vertex" type="uint" />
        <add name="vertex_count" type="uint" />
        <add name="verts" type="MeshReader" arg="#SELF#"/>
        <add name="size_of_tri_index" type="byte" default="2"/>
        <add name="num_tri_indices" type="uint" />
        <add name="tris" type="ushort" arr1="num_tri_indices #DIV# 3" arr2="3"/>
    </compound>

    <compound name="Chunk">
        <add name="tri_index_offset" type="uint" />
        <add name="num_tri_indices" type="uint" />
        <add name="vertex_offset" type="uint" />
        <add name="vertex_count" type="uint" />
        <add name="num_tris" type="uint" />
        <add name="bounds_extent" type="Vector3" />
        <add name="bounds_radius" type="float" />
    </compound>

    <compound name="Mesh">
        v 1: name may be junk bytes
        <add name="flag" type="ubyte" default="0"/>
        <add name="data_id" type="uint" />
        <add name="num_chunks" type="uint" default="1"/>2 in DiscoveryKiosk_df
        <add name="chunks" type="Chunk" arr1="num_chunks"/>
    </compound>

    <compound name="Bone">
        <add name="id" type="ubyte" />1-based
        <add name="parent_id" type="ubyte" />1-based
        <add name="group" type="ubyte" default="-1"/>todo calculate this value properly, refer values from other objects
        <add name="name" type="FixedString" arg="64" />
        <add name="matrix" type="Matrix44" />
    </compound>

    <compound name="Weight" allow_np="true">
        <add name="b0" type="ubyte" />
        <add name="b1" type="ubyte" />
        <add name="b2" type="ubyte" />
        <add name="b3" type="ubyte" />
        <add name="w0" type="float" />
        <add name="w1" type="float" />
        <add name="w2" type="float" />
    </compound>

    <compound name="MeshSkinned" inherit="Mesh">
        <add name="num_bones" type="uint" />
        <add name="num_weights" type="uint" />
        <add name="bones" type="Bone" arr1="num_bones" />
        <add name="weights" type="Weight" arr1="num_weights" />
    </compound>

	<compound name="BfbBlock">
        <add name="id" type="uint"/>
        <add name="type_id" type="BlockType"/>
        <add name="flag" type="ushort" default="32768"/>
        <add name="end" type="uint"/>
        <add name="name" type="FixedString" arg="64" />

        <add name="data" cond="type_id == 1" type="Sphere"/>
        <add name="data" cond="type_id == 3" type="BoundingBox"/>
        <add name="data" cond="type_id == 4" type="Capsule"/>
        <add name="data" cond="type_id == 5" type="Mesh"/>
        <add name="data" cond="type_id == 6" type="MeshData"/>
        <add name="data" cond="type_id == 8" type="MeshSkinned"/>
    </compound>
#
	<compound name="Node">
        <add name="unk 0" type="uint" />
        <add name="unk 1" type="uint" />
        <add name="num_colliders" type="uint"/>CrystalTunnel_df = 3
        <add name="collision_ids" type="uint" arr1="num_colliders"/>
    </compound>

	<compound name="LodGroup" inherit="Node">
        <add name="lodgroup" type="FixedString" arg="64" default="lodgroup"/>
    </compound>

	<compound name="MeshLink">
        <add name="u0" type="uint" default="1"/>anky: lod0 = 0, other lods = 2, unsure about non-lod
        <add name="u1" type="uint" default="1"/>anky: 0
        <add name="collision_id" type="uint" />
        <add name="num_objects" type="uint" default="1"/>
        <add name="object_ids" type="uint" arr1="num_objects" />
        <add name="num_materials" type="uint" default="1"/>2 for zoopedia_redwoodtunnel
        <add name="materials" type="FixedString" arr1="num_materials" arg="128" />
    </compound>

	<compound name="BillboardLink">
        164 bytes in old spec, maybe wrong or conditional
        172 bytes - themedtank_mm_top_curve135_long.bfb - 44 bytes until matname, all before vec are zero
        <add name="u0" type="uint"/>
        <add name="has_obj" type="uint" default="1"/>todo unsure if correct orientation
        <add name="u1" type="uint64"/>
        <add name="dummy" type="uint64"/>for themedtank_mm_top_curve135_long
        <add name="axis" type="Vector3"/>eg. 1.0, 0.0, -1.0
        <add name="u2" type="uint"/>
        <add name="object_id" type="uint"/>
        <add name="material" type="FixedString" arg="128" />
    </compound>

	<compound name="CapsuleLink">
        <add name="u0" type="uint" default="1"/>
        <add name="u1" type="uint" default="1"/>
        <add name="u2" type="uint" default="1"/>
        <add name="collision_id" type="uint"/>
        <add name="bone_name" type="FixedString" arg="64" >case-sensitive</add>
    </compound>

	<compound name="ParticleLink">
        76 bytes - CavePaintingHall
        <add name="u0" type="uint" default="1"/>
        <add name="u1" type="uint" default="1"/>
        <add name="u2" type="uint" default="1"/>
        <add name="emitter" type="FixedString" arg="64" >case-insensitive</add>
    </compound>

	<compound name="BfbNode">
        <add name="id" type="uint"/>
        <add name="type_id" type="NodeType"/>
        <add name="start_children" type="uint"/>
        <add name="start_sibling" type="uint"/>
        <add name="unk" type="ubyte" />anky: lod0 geom + node = 4, other lods = 0, unsure about rest
        <add name="name" type="FixedString" arg="64"/>
        <add name="matrix" type="Matrix44" />

        <add name="data" cond="type_id == 1" type="Node"/>
        <add name="data" cond="type_id == 2" type="LodGroup"/>
        <add name="data" cond="type_id == 3" type="MeshLink"/>
        <add name="data" cond="type_id == 4" type="BillboardLink"/>
        <add name="data" cond="type_id == 5" type="CapsuleLink"/>
        <add name="data" cond="type_id == 6" type="ParticleLink"/>

        <add name="children" type="BfbNode" arr1="0" abstract="True"/>
    </compound>

	<compound name="BfbHeader">
        <add name="magic" type="FixedString" arg="8" default="BFB!*000"/>
        <add name="version" type="uint64" default="4295098369"/>
<!--        <add name="version" type="ushort" arr1="4"/>latest: 1 2 1 0-->
        <add name="author" type="FixedString" arg="64" />
        <add name="num_blocks" type="uint"/>can be smaller than num_blocks_2
        <add name="num_blocks_2" type="uint"/>
    </compound>

	<compound name="BfbRoot">
        <add name="header" type="BfbHeader"/>
        <add name="blocks" type="BfbBlock" arr1="header \ num_blocks"/>
        <add name="tree" type="BfbNode" />
    </compound>

</niftoolsxml>